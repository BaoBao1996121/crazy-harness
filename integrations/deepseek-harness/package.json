{
  "name": "@crazy-harness/dsh-integration-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "dsh:check-pins": "node scripts/set-dsh-version.mjs --check",
    "dsh:pin": "node scripts/set-dsh-version.mjs",
    "pretest": "pnpm dsh:check-pins && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@types/js-yaml": "4.0.9",
    "js-yaml": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
